# SFTP Server
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=user
SFTP_PASSWORD=password

# The one directory the account may write to. sshd is chrooted to the account home, so the client sees
# this as /integration, not /home/user/integration.
SFTP_UPLOAD_DIR=integration

# Keys for public key authentication. `script.sh` generates these on first run into
# infra/integration/keys/, which is gitignored — a private key is never committed, not even a throwaway
# one. The server picks up every *.pub in that directory as authorized_keys.
SFTP_KEY_PATH=infra/integration/keys/id_ed25519
SFTP_ENCRYPTED_KEY_PATH=infra/integration/keys/id_ed25519_encrypted
SFTP_KEY_PASSPHRASE=integration

# An RSA key, so the ADR 014 dead end can be demonstrated rather than described.
SFTP_RSA_KEY_PATH=infra/integration/keys/id_rsa

# WebDAV (M3). Plain HTTP: TLS and the certificate prompt arrive in slice 3c with a terminator in front
# of this, and until then `webdav.allowsInsecureHTTP` on the bookmark is what lets a test reach it.
WEBDAV_HOST=localhost
WEBDAV_PORT=8081
WEBDAV_USER=duck
WEBDAV_PASSWORD=davpassword
