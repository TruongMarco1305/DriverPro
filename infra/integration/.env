# Which services `docker compose` starts when nothing says otherwise. Every service is behind a profile,
# so without this a bare `docker compose up` would start nothing at all — `script.sh` overrides it when
# given a feature name, and the manual instructions that call compose directly keep working.
COMPOSE_PROFILES=sftp,webdav,nextcloud,s3,localstack

# SFTP Server
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=user
SFTP_PASSWORD=password

# The one directory the account may write to. sshd is chrooted to the account home, so the client sees
# this as /integration, not /home/user/integration.
SFTP_UPLOAD_DIR=integration

# Keys for public key authentication. `script.sh` generates these on first run into
# infra/integration/keys/, which is gitignored — a private key is never committed, not even a throwaway
# one. The server picks up every *.pub in that directory as authorized_keys.
SFTP_KEY_PATH=infra/integration/keys/id_ed25519
SFTP_ENCRYPTED_KEY_PATH=infra/integration/keys/id_ed25519_encrypted
SFTP_KEY_PASSPHRASE=integration

# An RSA key, so the ADR 014 dead end can be demonstrated rather than described.
SFTP_RSA_KEY_PATH=infra/integration/keys/id_rsa

# WebDAV (M3). Plain HTTP: TLS and the certificate prompt arrive in slice 3c with a terminator in front
# of this, and until then `webdav.allowsInsecureHTTP` on the bookmark is what lets a test reach it.
WEBDAV_HOST=localhost
WEBDAV_PORT=8081
WEBDAV_USER=duck
WEBDAV_PASSWORD=davpassword

# The same server behind TLS, with a self-signed certificate — what the certificate prompt is tested
# against. Plain HTTP stays available on WEBDAV_PORT for the tests that are not about trust.
WEBDAV_TLS_PORT=8443

# Nextcloud (M3, slice 3d). The DAV root includes the user name, which is the whole point: it is a
# bookmark property, not a code path.
NEXTCLOUD_HOST=localhost
NEXTCLOUD_PORT=8082
NEXTCLOUD_USER=duck
NEXTCLOUD_PASSWORD=nextcloudpassword
NEXTCLOUD_BASE_PATH=/remote.php/dav/files/duck

# The same Nextcloud behind TLS. The integration tests do not need it — they set
# `webdav.allowsInsecureHTTP` and talk to NEXTCLOUD_PORT directly — but the *app* has no UI for that
# property and always builds an https:// URL, so this is the only way a person can point DriverPro at
# the local Nextcloud by hand. Which makes the manual pass exercise the trust prompt too.
NEXTCLOUD_TLS_PORT=8444

# MinIO (M4). Plain HTTP, reached with `s3.allowsInsecureHTTP` on the bookmark — the same arrangement
# the WebDAV container uses, and for the same reason: TLS is a separate question from the protocol.
#
# The user name *is* the access key id, which is why there is no S3_USER here: `RemoteHost.username`
# carries it, and `Credentials.password` carries the secret. That mapping is the whole of S3 auth.
S3_HOST=localhost
S3_PORT=9000
S3_ACCESS_KEY=driverpro
S3_SECRET_KEY=driverpropassword
S3_REGION=us-east-1

# Two buckets, because one proves nothing about listing the root: `ListBuckets` returning a single
# entry looks identical to a listing that hard-coded it. The second is created as `${S3_BUCKET}-second`.
S3_BUCKET=integration

# LocalStack (M4). A second S3 implementation, on its own feature so that a change to the S3 backend can
# be checked against both — M3 learned that one server is not evidence about another.
#
# The credentials are the ones LocalStack documents. It accepts any keys at all, but writing `test` here
# says that plainly rather than leaving a reader wondering which account these belong to.
LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566
LOCALSTACK_ACCESS_KEY=test
LOCALSTACK_SECRET_KEY=test
LOCALSTACK_REGION=us-east-1

# Unlike MinIO there is no data directory to pre-seed, so the suite creates this bucket itself.
LOCALSTACK_BUCKET=integration
